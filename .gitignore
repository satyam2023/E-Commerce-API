## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
bin/
obj/
out/

# Rider
.idea/

# User-specific files
*.user
*.userosscache
*.suo
*.sln.docstates
*.userprefs

# Mono Auto Generated Files
mono_crash.*

# Visual Studio Code
.vscode/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Templated projects
**/wwwroot/
**/appsettings.Development.json

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
# Uncomment if using package restore
# !packages/build/
# !packages/repositories.config

# Microsoft Azure Web App publish settings
*.PublishSettings
*.azurePubxml

# Others
*.dbmdl
*.bak
*.log
*.DS_Store
*.vs/
*.coverage
TestResults/
*.tgz

# Entity Framework Core
Migrations/

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Local configuration
secrets.json
.env

# Node modules (if using NodeJS/npm in your .NET project)
node_modules/

# Yarn
.yarn/
.pnp.*

# Logs
logs/
*.log
